import React, { useState } from 'react';
import {
  Producto,
  Remito,
  Cliente,
  Proveedor,
  IngresoStock,
  IngresoStockItem,
  DatosEmpresa,
  ModuleSecurityConfig
} from '../types';
import {
  Package,
  ClipboardList,
  ArrowDownRight,
  Search,
  CheckCircle2,
  Clock,
  AlertTriangle,
  Check,
  Plus,
  Truck,
  Building2,
  Calendar,
  Printer,
  ArrowRight,
  Filter,
  Box,
  FileText,
  ShieldCheck,
  RotateCcw,
  Boxes,
  CheckSquare,
  Square,
  RefreshCw,
  Info,
  KeyRound,
  Lock,
  Shield,
  Eye,
  EyeOff
} from 'lucide-react';

interface DepositoModuleProps {
  productos: Producto[];
  setProductos: React.Dispatch<React.SetStateAction<Producto[]>>;
  remitos: Remito[];
  setRemitos: React.Dispatch<React.SetStateAction<Remito[]>>;
  clientes: Cliente[];
  proveedores: Proveedor[];
  ingresosStock: IngresoStock[];
  setIngresosStock: React.Dispatch<React.SetStateAction<IngresoStock[]>>;
  datosEmpresa: DatosEmpresa;
  onPrintRemito: (remito: Remito) => void;
  onSwitchToAdmin: () => void;
}

export function DepositoModule({
  productos,
  setProductos,
  remitos,
  setRemitos,
  clientes,
  proveedores,
  ingresosStock,
  setIngresosStock,
  datosEmpresa,
  onPrintRemito,
  onSwitchToAdmin
}: DepositoModuleProps) {
  const [depositoTab, setDepositoTab] = useState<'resumen' | 'preparacion' | 'ingresos' | 'productos'>('resumen');

  // Modal State for Order Preparation
  const [preparingRemito, setPreparingRemito] = useState<Remito | null>(null);

  // Modal State for New Stock Entry in Depósito
  const [isIngresoModalOpen, setIsIngresoModalOpen] = useState(false);
  const [ingresoFecha, setIngresoFecha] = useState(() => new Date().toISOString().split('T')[0]);
  const [ingresoProveedorId, setIngresoProveedorId] = useState('');
  const [ingresoComprobante, setIngresoComprobante] = useState('');
  const [ingresoObservaciones, setIngresoObservaciones] = useState('');
  const [ingresoItems, setIngresoItems] = useState<{ productoId: string; cantidad: number }[]>([
    { productoId: '', cantidad: 1 }
  ]);

  // Modal State for Quick Physical Stock Adjustment
  const [adjustingProduct, setAdjustingProduct] = useState<Producto | null>(null);
  const [adjustNewStock, setAdjustNewStock] = useState<number>(0);
  const [adjustReason, setAdjustReason] = useState<string>('Recuento físico depósito');

  // Search & Filters
  const [searchQuery, setSearchQuery] = useState('');
  const [filterLowStockOnly, setFilterLowStockOnly] = useState(false);
  const [remitoFilterEstado, setRemitoFilterEstado] = useState<'Todos' | 'Pendientes' | 'En Preparación' | 'Listo para Entrega' | 'Entregado'>('Todos');

  // Helper functions
  const getClienteName = (clienteId: string) => {
    const c = clientes.find((cli) => cli.id === clienteId);
    return c ? c.nombre : 'Cliente Desconocido';
  };

  const getClienteInfo = (clienteId: string) => {
    return clientes.find((cli) => cli.id === clienteId);
  };

  const getProveedorName = (proveedorId: string) => {
    const p = proveedores.find((prov) => prov.id === proveedorId);
    return p ? p.nombre : 'Proveedor sin registrar';
  };

  const getProducto = (productoId: string) => {
    return productos.find((p) => p.id === productoId);
  };

  // Metrics for Depósito
  const pedidiosPendientes = remitos.filter(r => r.estado === 'Borrador' || r.estado === 'En Preparación');
  const pedidiosListos = remitos.filter(r => r.estado === 'Listo para Entrega');
  const productosBajoStock = productos.filter(p => p.stock <= (p.stockMinimo ?? 10));

  const now = new Date();
  const currentYearMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  const ingresosMes = ingresosStock.filter(ing => ing.fecha?.startsWith(currentYearMonth));
  const unidadesIngresadasMes = ingresosMes.reduce((sum, ing) => {
    return sum + (ing.items || []).reduce((s, it) => s + it.cantidad, 0);
  }, 0);

  // --- ORDER PREPARATION LOGIC ---
  const toggleItemPreparado = (remitoId: string, productoId: string) => {
    setRemitos(prev =>
      prev.map(r => {
        if (r.id !== remitoId) return r;
        const updatedItems = r.items.map(it => {
          if (it.productoId === productoId) {
            return { ...it, preparado: !it.preparado };
          }
          return it;
        });
        return { ...r, items: updatedItems };
      })
    );

    if (preparingRemito && preparingRemito.id === remitoId) {
      setPreparingRemito(prev => {
        if (!prev) return null;
        const updatedItems = prev.items.map(it => {
          if (it.productoId === productoId) {
            return { ...it, preparado: !it.preparado };
          }
          return it;
        });
        return { ...prev, items: updatedItems };
      });
    }
  };

  const markAllItemsPreparado = (remitoId: string) => {
    setRemitos(prev =>
      prev.map(r => {
        if (r.id !== remitoId) return r;
        return {
          ...r,
          items: r.items.map(it => ({ ...it, preparado: true }))
        };
      })
    );

    if (preparingRemito && preparingRemito.id === remitoId) {
      setPreparingRemito(prev => {
        if (!prev) return null;
        return {
          ...prev,
          items: prev.items.map(it => ({ ...it, preparado: true }))
        };
      });
    }
  };

  const updateRemitoEstado = (remitoId: string, newEstado: Remito['estado']) => {
    setRemitos(prev =>
      prev.map(r => {
        if (r.id === remitoId) {
          return { ...r, estado: newEstado };
        }
        return r;
      })
    );
    if (preparingRemito && preparingRemito.id === remitoId) {
      setPreparingRemito(prev => (prev ? { ...prev, estado: newEstado } : null));
    }
  };

  // --- STOCK RECEPTION LOGIC (No costs) ---
  const handleAddIngresoItem = () => {
    setIngresoItems(prev => [...prev, { productoId: '', cantidad: 1 }]);
  };

  const handleRemoveIngresoItem = (index: number) => {
    setIngresoItems(prev => prev.filter((_, i) => i !== index));
  };

  const handleIngresoItemChange = (index: number, field: 'productoId' | 'cantidad', value: string | number) => {
    setIngresoItems(prev => {
      const copy = [...prev];
      copy[index] = { ...copy[index], [field]: value };
      return copy;
    });
  };

  const handleSubmitIngreso = (e: React.FormEvent) => {
    e.preventDefault();
    if (!ingresoProveedorId) {
      alert('Por favor selecciona un proveedor.');
      return;
    }

    const validItems = ingresoItems.filter(it => it.productoId && it.cantidad > 0);
    if (validItems.length === 0) {
      alert('Debes agregar al menos un producto con cantidad válida.');
      return;
    }

    const newIngreso: IngresoStock = {
      id: 'ing-' + Date.now(),
      fecha: ingresoFecha,
      proveedorId: ingresoProveedorId,
      comprobante: ingresoComprobante || 'Ingreso Depósito',
      observaciones: ingresoObservaciones,
      items: validItems.map((it, idx) => ({
        id: `item-${Date.now()}-${idx}`,
        productoId: it.productoId,
        cantidad: Number(it.cantidad)
      }))
    };

    // Update Stock in products
    setProductos(prevProducts =>
      prevProducts.map(p => {
        const itemAdded = validItems.find(it => it.productoId === p.id);
        if (itemAdded) {
          return {
            ...p,
            stock: p.stock + Number(itemAdded.cantidad)
          };
        }
        return p;
      })
    );

    setIngresosStock(prev => [newIngreso, ...prev]);

    // Reset Form
    setIngresoProveedorId('');
    setIngresoComprobante('');
    setIngresoObservaciones('');
    setIngresoItems([{ productoId: '', cantidad: 1 }]);
    setIsIngresoModalOpen(false);

    alert('✅ Stock ingresado correctamente en depósito.');
  };

  // --- MANUAL STOCK ADJUSTMENT ---
  const handleConfirmStockAdjustment = () => {
    if (!adjustingProduct) return;
    const newStockVal = Math.max(0, Number(adjustNewStock));

    setProductos(prev =>
      prev.map(p => (p.id === adjustingProduct.id ? { ...p, stock: newStockVal } : p))
    );

    setAdjustingProduct(null);
  };

  // Filtered lists
  const filteredRemitos = remitos.filter(r => {
    if (remitoFilterEstado === 'Pendientes') return r.estado === 'Borrador' || r.estado === 'En Preparación';
    if (remitoFilterEstado === 'En Preparación') return r.estado === 'En Preparación';
    if (remitoFilterEstado === 'Listo para Entrega') return r.estado === 'Listo para Entrega';
    if (remitoFilterEstado === 'Entregado') return r.estado === 'Entregado';
    return true;
  });

  const filteredProductos = productos.filter(p => {
    if (filterLowStockOnly && p.stock > (p.stockMinimo ?? 10)) return false;
    if (!searchQuery.trim()) return true;
    const q = searchQuery.toLowerCase();
    const codInt = (p.codigoInterno || p.codigo || '').toLowerCase();
    const codProv = (p.codigoProveedor || '').toLowerCase();
    const name = p.nombre.toLowerCase();
    const prov = getProveedorName(p.proveedorId).toLowerCase();
    return codInt.includes(q) || codProv.includes(q) || name.includes(q) || prov.includes(q);
  });

  return (
    <div className="space-y-6 pb-12">
      {/* Module Header Banner with Switcher */}
      <div className="bg-gradient-to-r from-slate-900 via-amber-950 to-slate-900 text-white rounded-2xl p-5 shadow-lg border border-amber-900/40 relative overflow-hidden">
        <div className="absolute right-0 top-0 bottom-0 w-1/3 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-transparent pointer-events-none" />
        
        <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 relative z-10">
          <div className="flex items-center gap-3.5">
            <div className="p-3 bg-amber-500 text-slate-950 rounded-xl shadow-md shrink-0">
              <Boxes className="w-6 h-6" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className="bg-amber-400 text-slate-950 font-black text-[10px] uppercase tracking-wider px-2 py-0.5 rounded">
                  MÓDULO DEPÓSITO Y ALMACÉN
                </span>
                <span className="text-xs text-amber-200/90 font-medium flex items-center gap-1">
                  <ShieldCheck className="w-3.5 h-3.5 text-amber-400" /> Modo Operativo (Sin Valores Monetarios)
                </span>
              </div>
              <h1 className="text-xl font-bold mt-0.5 tracking-tight text-white">
                Preparación de Pedidos, Recepción de Stock y Control Físico
              </h1>
            </div>
          </div>

          <div className="flex items-center gap-3 self-end lg:self-center">
            <button
              onClick={onSwitchToAdmin}
              className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-2 cursor-pointer"
              title="Cambiar al Módulo Administrador"
            >
              <RotateCcw className="w-4 h-4 text-amber-400" />
              <span>Ir a Módulo Administrador</span>
            </button>
          </div>
        </div>

        {/* Depósito Navigation Tabs */}
        <div className="flex items-center gap-2 pt-5 border-t border-slate-800/80 mt-5 overflow-x-auto no-scrollbar">
          <button
            onClick={() => setDepositoTab('resumen')}
            className={`px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
              depositoTab === 'resumen'
                ? 'bg-amber-500 text-slate-950 shadow-sm'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <Boxes className="w-4 h-4" />
            <span>Resumen Depósito</span>
          </button>

          <button
            onClick={() => setDepositoTab('preparacion')}
            className={`px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
              depositoTab === 'preparacion'
                ? 'bg-amber-500 text-slate-950 shadow-sm'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <ClipboardList className="w-4 h-4" />
            <span>Preparación de Pedidos ({pedidiosPendientes.length})</span>
          </button>

          <button
            onClick={() => setDepositoTab('ingresos')}
            className={`px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
              depositoTab === 'ingresos'
                ? 'bg-amber-500 text-slate-950 shadow-sm'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <ArrowDownRight className="w-4 h-4" />
            <span>Ingresos de Stock</span>
          </button>

          <button
            onClick={() => setDepositoTab('productos')}
            className={`px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
              depositoTab === 'productos'
                ? 'bg-amber-500 text-slate-950 shadow-sm'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <Package className="w-4 h-4" />
            <span>Productos y Stock Físico</span>
          </button>
        </div>
      </div>

      {/* TAB 1: RESUMEN DEPÓSITO */}
      {depositoTab === 'resumen' && (
        <div className="space-y-6 animate-in fade-in duration-200">
          {/* Key Metrics Grid */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3.5">
              <div className="p-3 bg-amber-100 text-amber-800 rounded-xl shrink-0">
                <Clock className="w-6 h-6" />
              </div>
              <div>
                <p className="text-xs text-slate-500 font-medium">Pedidos x Preparar</p>
                <p className="text-2xl font-bold text-slate-900">{pedidiosPendientes.length}</p>
                <p className="text-[10px] text-amber-700 font-semibold mt-0.5">En cola de armado</p>
              </div>
            </div>

            <div className="bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3.5">
              <div className="p-3 bg-emerald-100 text-emerald-800 rounded-xl shrink-0">
                <CheckCircle2 className="w-6 h-6" />
              </div>
              <div>
                <p className="text-xs text-slate-500 font-medium">Listos p/ Despacho</p>
                <p className="text-2xl font-bold text-slate-900">{pedidiosListos.length}</p>
                <p className="text-[10px] text-emerald-700 font-semibold mt-0.5">Preparados en depósito</p>
              </div>
            </div>

            <div className="bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3.5">
              <div className="p-3 bg-indigo-100 text-indigo-800 rounded-xl shrink-0">
                <ArrowDownRight className="w-6 h-6" />
              </div>
              <div>
                <p className="text-xs text-slate-500 font-medium">Stock Recibido (Mes)</p>
                <p className="text-2xl font-bold text-slate-900 font-mono">+{unidadesIngresadasMes.toLocaleString('es-AR')} u.</p>
                <p className="text-[10px] text-indigo-700 font-semibold mt-0.5">{ingresosMes.length} recepciones</p>
              </div>
            </div>

            <div className="bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3.5">
              <div className="p-3 bg-rose-100 text-rose-800 rounded-xl shrink-0">
                <AlertTriangle className="w-6 h-6" />
              </div>
              <div>
                <p className="text-xs text-slate-500 font-medium">Bajo Stock Crítico</p>
                <p className="text-2xl font-bold text-slate-900">{productosBajoStock.length}</p>
                <p className="text-[10px] text-rose-700 font-semibold mt-0.5">Alertas de reposición</p>
              </div>
            </div>
          </div>

          {/* Direct Action Cards */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <button
              onClick={() => setDepositoTab('preparacion')}
              className="p-5 bg-gradient-to-br from-amber-500/10 via-amber-50 to-white border border-amber-300 rounded-xl text-left hover:shadow-md transition-all cursor-pointer group"
            >
              <div className="flex items-center justify-between mb-3">
                <div className="p-2.5 bg-amber-500 text-white rounded-lg group-hover:scale-105 transition-transform">
                  <ClipboardList className="w-5 h-5" />
                </div>
                <ArrowRight className="w-4 h-4 text-amber-700 group-hover:translate-x-1 transition-transform" />
              </div>
              <h3 className="font-extrabold text-slate-900 text-base">Preparar Pedidos</h3>
              <p className="text-xs text-slate-600 mt-1">
                Abre la lista interactiva de armado y picking por ítems.
              </p>
            </button>

            <button
              onClick={() => {
                setDepositoTab('ingresos');
                setIsIngresoModalOpen(true);
              }}
              className="p-5 bg-gradient-to-br from-emerald-500/10 via-emerald-50 to-white border border-emerald-300 rounded-xl text-left hover:shadow-md transition-all cursor-pointer group"
            >
              <div className="flex items-center justify-between mb-3">
                <div className="p-2.5 bg-emerald-600 text-white rounded-lg group-hover:scale-105 transition-transform">
                  <Plus className="w-5 h-5" />
                </div>
                <ArrowRight className="w-4 h-4 text-emerald-700 group-hover:translate-x-1 transition-transform" />
              </div>
              <h3 className="font-extrabold text-slate-900 text-base">Ingreso de Stock</h3>
              <p className="text-xs text-slate-600 mt-1">
                Recibe mercadería de proveedores y suma unidades al stock.
              </p>
            </button>

            <button
              onClick={() => setDepositoTab('productos')}
              className="p-5 bg-gradient-to-br from-slate-100 via-slate-50 to-white border border-slate-300 rounded-xl text-left hover:shadow-md transition-all cursor-pointer group"
            >
              <div className="flex items-center justify-between mb-3">
                <div className="p-2.5 bg-slate-800 text-white rounded-lg group-hover:scale-105 transition-transform">
                  <Package className="w-5 h-5" />
                </div>
                <ArrowRight className="w-4 h-4 text-slate-700 group-hover:translate-x-1 transition-transform" />
              </div>
              <h3 className="font-extrabold text-slate-900 text-base">Stock Físico</h3>
              <p className="text-xs text-slate-600 mt-1">
                Busca productos por SKU, revisa disponibilidad y recuentos.
              </p>
            </button>
          </div>

          {/* Pending Orders Checklist Preview */}
          <div className="bg-white rounded-2xl border border-slate-200 shadow-2xs p-5 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 className="text-base font-extrabold text-slate-900 flex items-center gap-2">
                  <ClipboardList className="w-5 h-5 text-amber-600" />
                  <span>Pedidos Pendientes de Preparación</span>
                </h3>
                <p className="text-xs text-slate-500">
                  Ordenes recibidas para armar en depósito antes del despacho
                </p>
              </div>
              <button
                onClick={() => setDepositoTab('preparacion')}
                className="text-xs font-bold text-amber-700 hover:text-amber-800 flex items-center gap-1 cursor-pointer"
              >
                <span>Ver Todos los Pedidos</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </button>
            </div>

            {pedidiosPendientes.length === 0 ? (
              <div className="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-500 text-xs">
                <CheckCircle2 className="w-8 h-8 text-emerald-500 mx-auto mb-2" />
                <p className="font-bold text-slate-800">¡No hay pedidos pendientes de armado en este momento!</p>
                <p className="text-slate-500 mt-0.5">Todos los remitos registrados están preparados o entregados.</p>
              </div>
            ) : (
              <div className="space-y-3">
                {pedidiosPendientes.map(remito => {
                  const cliente = getClienteInfo(remito.clienteId);
                  const totalBultos = remito.items.reduce((s, it) => s + it.cantidad, 0);
                  const preparadosCount = remito.items.filter(it => it.preparado).length;
                  const isFullyPrepared = preparadosCount === remito.items.length && remito.items.length > 0;

                  return (
                    <div
                      key={remito.id}
                      className="p-4 bg-slate-50 rounded-xl border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:border-amber-300 transition-colors"
                    >
                      <div className="space-y-1">
                        <div className="flex items-center gap-2">
                          <span className="font-mono text-xs font-black text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200">
                            Remito {remito.numero}
                          </span>
                          <span className={`text-[10px] font-extrabold uppercase px-2 py-0.5 rounded ${
                            remito.estado === 'En Preparación'
                              ? 'bg-amber-100 text-amber-900 border border-amber-300'
                              : 'bg-slate-200 text-slate-800'
                          }`}>
                            {remito.estado}
                          </span>
                          <span className="text-xs text-slate-400 font-mono">
                            {remito.fecha.split('-').reverse().join('/')}
                          </span>
                        </div>

                        <p className="text-sm font-bold text-slate-900">
                          Cliente: {cliente?.nombre || 'Cliente sin registrar'}
                        </p>
                        <p className="text-xs text-slate-500">
                          Destino: {cliente?.direccion || 'Sin dirección'}, {cliente?.ciudad || 'S/D'} • Total Bultos: <strong className="text-slate-800 font-mono">{totalBultos} u.</strong>
                        </p>
                      </div>

                      <div className="flex items-center gap-3 shrink-0">
                        <div className="text-right text-xs">
                          <span className="block font-bold text-slate-700">
                            {preparadosCount} / {remito.items.length} ítems listos
                          </span>
                          <span className="text-[10px] text-slate-400">
                            {isFullyPrepared ? '100% verificado' : 'Checklist en curso'}
                          </span>
                        </div>

                        <button
                          onClick={() => setPreparingRemito(remito)}
                          className="px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 shadow-xs"
                        >
                          <ClipboardList className="w-3.5 h-3.5" />
                          <span>Armar Pedido</span>
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      )}

      {/* TAB 2: PREPARACIÓN DE PEDIDOS (PICKING) */}
      {depositoTab === 'preparacion' && (
        <div className="space-y-6 animate-in fade-in duration-200">
          <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
            <div>
              <h2 className="text-lg font-extrabold text-slate-900">Preparación y Control de Pedidos</h2>
              <p className="text-xs text-slate-500">
                Pickea los ítems de los remitos, marca la preparación y cambia el estado para despacho
              </p>
            </div>

            {/* Filter buttons */}
            <div className="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl overflow-x-auto w-full sm:w-auto">
              {(['Todos', 'Pendientes', 'En Preparación', 'Listo para Entrega', 'Entregado'] as const).map(f => (
                <button
                  key={f}
                  onClick={() => setRemitoFilterEstado(f)}
                  className={`px-3 py-1.5 text-xs font-bold rounded-lg transition-colors cursor-pointer shrink-0 ${
                    remitoFilterEstado === f
                      ? 'bg-white text-slate-900 shadow-2xs'
                      : 'text-slate-600 hover:text-slate-900'
                  }`}
                >
                  {f}
                </button>
              ))}
            </div>
          </div>

          {/* List of Remitos for Preparation */}
          <div className="space-y-3">
            {filteredRemitos.length === 0 ? (
              <div className="p-8 text-center bg-white rounded-2xl border border-slate-200 text-slate-500 text-xs">
                No hay pedidos en la categoría seleccionada ({remitoFilterEstado}).
              </div>
            ) : (
              filteredRemitos.map(remito => {
                const cliente = getClienteInfo(remito.clienteId);
                const totalBultos = remito.items.reduce((s, it) => s + it.cantidad, 0);
                const preparadosCount = remito.items.filter(it => it.preparado).length;
                const isFullyPrepared = preparadosCount === remito.items.length && remito.items.length > 0;

                return (
                  <div
                    key={remito.id}
                    className="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs space-y-3 hover:border-slate-300 transition-all"
                  >
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="font-mono text-sm font-black text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded border border-slate-200">
                            Remito {remito.numero}
                          </span>
                          <span className={`text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full ${
                            remito.estado === 'Entregado'
                              ? 'bg-emerald-100 text-emerald-800'
                              : remito.estado === 'Listo para Entrega'
                              ? 'bg-teal-100 text-teal-900 border border-teal-300'
                              : remito.estado === 'En Preparación'
                              ? 'bg-amber-100 text-amber-900 border border-amber-300'
                              : 'bg-slate-200 text-slate-800'
                          }`}>
                            {remito.estado}
                          </span>
                          <span className="text-xs text-slate-400 font-mono">
                            Fecha: {remito.fecha.split('-').reverse().join('/')}
                          </span>
                        </div>
                        <h3 className="text-base font-extrabold text-slate-900 mt-1">
                          {cliente?.nombre || 'Cliente sin registrar'}
                        </h3>
                        <p className="text-xs text-slate-500 flex items-center gap-2 flex-wrap mt-0.5">
                          <span>Domicilio: <strong>{cliente?.direccion || 'Sin dirección'}</strong> ({cliente?.ciudad || 'S/D'})</span>
                          <span>• Tel: <strong>{cliente?.telefono || 'S/D'}</strong></span>
                        </p>
                      </div>

                      <div className="flex flex-wrap items-center gap-2 self-start sm:self-center shrink-0">
                        <button
                          onClick={() => setPreparingRemito(remito)}
                          className="px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 shadow-2xs"
                        >
                          <ClipboardList className="w-4 h-4" />
                          <span>Abrir Picking / Checklist</span>
                        </button>

                        <button
                          onClick={() => onPrintRemito(remito)}
                          className="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 border border-slate-200"
                          title="Imprimir Hoja de Carga / Remito"
                        >
                          <Printer className="w-4 h-4 text-slate-600" />
                          <span>Imprimir</span>
                        </button>
                      </div>
                    </div>

                    {/* Quick Items Preview */}
                    <div className="bg-slate-50/80 p-3 rounded-xl border border-slate-200/80 text-xs space-y-1.5">
                      <div className="flex items-center justify-between font-semibold text-slate-600 text-[11px] uppercase tracking-wider">
                        <span>Detalle de ítems a armar ({remito.items.length} productos)</span>
                        <span className="font-mono text-slate-900 font-bold">Total Bultos: {totalBultos} u.</span>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 pt-1">
                        {remito.items.map((item, idx) => {
                          const prod = getProducto(item.productoId);
                          return (
                            <div
                              key={idx}
                              className={`p-2 rounded-lg border flex items-center justify-between text-xs ${
                                item.preparado
                                  ? 'bg-emerald-50/80 border-emerald-200 text-emerald-950'
                                  : 'bg-white border-slate-200 text-slate-800'
                              }`}
                            >
                              <div className="min-w-0 pr-1">
                                <div className="font-bold truncate" title={prod?.nombre}>
                                  {prod?.nombre || 'Producto descontinuado'}
                                </div>
                                <div className="text-[10px] text-slate-500 font-mono">
                                  SKU: {prod?.codigoInterno || prod?.codigo || 'S/C'}
                                </div>
                              </div>
                              <div className="text-right shrink-0 flex items-center gap-1.5">
                                <span className="font-mono font-black text-slate-900 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">
                                  {item.cantidad} u.
                                </span>
                                {item.preparado && (
                                  <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0" />
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      )}

      {/* TAB 3: INGRESOS DE STOCK (DEPÓSITO - SIN VALORES) */}
      {depositoTab === 'ingresos' && (
        <div className="space-y-6 animate-in fade-in duration-200">
          <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs">
            <div>
              <h2 className="text-lg font-extrabold text-slate-900">Recepción de Mercadería en Depósito</h2>
              <p className="text-xs text-slate-500">
                Registra los ingresos físicos de stock desde proveedores (cantidades y números de comprobante)
              </p>
            </div>
            <button
              onClick={() => setIsIngresoModalOpen(true)}
              className="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-colors shadow-xs flex items-center gap-2 cursor-pointer"
            >
              <Plus className="w-4 h-4" />
              <span>Nuevo Ingreso de Stock</span>
            </button>
          </div>

          {/* Past Stock Inflows History (NO COSTS/PRICES DISPLAYED) */}
          <div className="bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden">
            <div className="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
              <h3 className="font-extrabold text-slate-900 text-sm flex items-center gap-2">
                <ArrowDownRight className="w-4 h-4 text-emerald-600" />
                <span>Historial de Recepciones de Mercadería ({ingresosStock.length})</span>
              </h3>
            </div>

            {ingresosStock.length === 0 ? (
              <div className="p-8 text-center text-slate-500 text-xs">
                No hay recepciones de stock registradas aún.
              </div>
            ) : (
              <div className="divide-y divide-slate-200">
                {ingresosStock.map(ing => {
                  const provName = getProveedorName(ing.proveedorId);
                  const items = ing.items || [];
                  const totalUnidades = items.reduce((s, it) => s + it.cantidad, 0);

                  return (
                    <div key={ing.id} className="p-4 hover:bg-slate-50/60 transition-colors space-y-2">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                          <div className="flex items-center gap-2">
                            <span className="font-mono text-xs font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                              {ing.comprobante || 'Sin N° Comprobante'}
                            </span>
                            <span className="text-xs text-slate-400 font-mono">
                              {ing.fecha.split('-').reverse().join('/')}
                            </span>
                          </div>
                          <p className="text-sm font-bold text-slate-900 mt-0.5">
                            Proveedor: {provName}
                          </p>
                        </div>
                        <div className="text-right">
                          <span className="text-xs font-mono font-black text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                            +{totalUnidades.toLocaleString('es-AR')} u. recibidas
                          </span>
                        </div>
                      </div>

                      {/* Items table */}
                      <div className="bg-white p-2.5 rounded-lg border border-slate-200 text-xs space-y-1">
                        <div className="grid grid-cols-12 text-[10px] font-bold text-slate-400 uppercase tracking-wider pb-1 border-b border-slate-100">
                          <span className="col-span-3">Código / SKU</span>
                          <span className="col-span-7">Producto</span>
                          <span className="col-span-2 text-right">Cant. Ingresada</span>
                        </div>
                        {items.map((it, i) => {
                          const prod = getProducto(it.productoId);
                          return (
                            <div key={i} className="grid grid-cols-12 text-xs py-0.5 items-center">
                              <span className="col-span-3 font-mono text-slate-600">
                                {prod?.codigoInterno || prod?.codigo || 'S/C'}
                              </span>
                              <span className="col-span-7 font-semibold text-slate-900 truncate">
                                {prod?.nombre || 'Producto sin identificar'}
                              </span>
                              <span className="col-span-2 text-right font-mono font-bold text-emerald-700">
                                +{it.cantidad} u.
                              </span>
                            </div>
                          );
                        })}
                      </div>

                      {ing.observaciones && (
                        <p className="text-xs text-slate-500 italic">
                          Obs: {ing.observaciones}
                        </p>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      )}

      {/* TAB 4: PRODUCTOS Y STOCK FÍSICO (WITHOUT PRICES/COSTS) */}
      {depositoTab === 'productos' && (
        <div className="space-y-6 animate-in fade-in duration-200">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-4.5 rounded-xl border border-slate-200 shadow-2xs">
            <div>
              <h2 className="text-lg font-extrabold text-slate-900">Control Físico de Productos y Stock</h2>
              <p className="text-xs text-slate-500">
                Consulta existencias físicas, códigos de proveedor y realiza recuentos de inventario
              </p>
            </div>

            <div className="flex items-center gap-2.5 flex-wrap sm:flex-nowrap">
              <div className="relative flex-1 sm:w-64">
                <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
                <input
                  type="text"
                  placeholder="Buscar por SKU, Nombre..."
                  value={searchQuery}
                  onChange={e => setSearchQuery(e.target.value)}
                  className="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-hidden focus:ring-2 focus:ring-amber-500/20"
                />
              </div>

              <button
                type="button"
                onClick={() => setFilterLowStockOnly(!filterLowStockOnly)}
                className={`px-3 py-2 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 cursor-pointer border ${
                  filterLowStockOnly
                    ? 'bg-rose-600 text-white border-rose-700 shadow-2xs'
                    : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'
                }`}
              >
                <AlertTriangle className={`w-3.5 h-3.5 ${filterLowStockOnly ? 'text-white' : 'text-rose-600'}`} />
                <span>{filterLowStockOnly ? 'Solo Bajo Stock' : 'Filtrar Bajo Stock'}</span>
              </button>
            </div>
          </div>

          {/* Products Table - Pure Physical Quantities */}
          <div className="bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden">
            <div className="overflow-x-auto">
              <table className="w-full text-xs text-left border-collapse">
                <thead>
                  <tr className="bg-slate-50 border-b border-slate-200 font-bold text-slate-700 uppercase tracking-wider text-[10px]">
                    <th className="px-4 py-3">Código SKU / Int</th>
                    <th className="px-4 py-3">Cód. Proveedor</th>
                    <th className="px-4 py-3">Nombre / Descripción</th>
                    <th className="px-4 py-3">Proveedor Hab.</th>
                    <th className="px-4 py-3 text-center">Stock Mínimo</th>
                    <th className="px-4 py-3 text-right">Stock Físico Actual</th>
                    <th className="px-4 py-3 text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {filteredProductos.length === 0 ? (
                    <tr>
                      <td colSpan={7} className="p-8 text-center text-slate-500 text-xs">
                        No se encontraron productos con el filtro aplicado.
                      </td>
                    </tr>
                  ) : (
                    filteredProductos.map(p => {
                      const isLowStock = p.stock <= (p.stockMinimo ?? 10);
                      const provName = getProveedorName(p.proveedorId);

                      return (
                        <tr
                          key={p.id}
                          className={`hover:bg-slate-50/60 transition-colors ${
                            isLowStock ? 'bg-rose-50/40' : ''
                          }`}
                        >
                          <td className="px-4 py-3 font-mono font-bold text-slate-900">
                            {p.codigoInterno || p.codigo}
                          </td>
                          <td className="px-4 py-3 font-mono text-slate-500">
                            {p.codigoProveedor || '-'}
                          </td>
                          <td className="px-4 py-3 max-w-xs">
                            <div className="font-bold text-slate-900">{p.nombre}</div>
                            {p.descripcion && (
                              <div className="text-[10px] text-slate-500 truncate">{p.descripcion}</div>
                            )}
                          </td>
                          <td className="px-4 py-3 text-slate-600 font-medium">
                            {provName}
                          </td>
                          <td className="px-4 py-3 text-center font-mono text-slate-500">
                            {p.stockMinimo ?? 10} u.
                          </td>
                          <td className="px-4 py-3 text-right">
                            <span className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg font-mono font-black text-sm ${
                              isLowStock
                                ? 'bg-rose-100 text-rose-900 border border-rose-300'
                                : 'bg-emerald-50 text-emerald-900 border border-emerald-200'
                            }`}>
                              {p.stock} u.
                            </span>
                          </td>
                          <td className="px-4 py-3 text-center">
                            <button
                              onClick={() => {
                                setAdjustingProduct(p);
                                setAdjustNewStock(p.stock);
                              }}
                              className="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-lg transition-colors border border-slate-200 cursor-pointer"
                              title="Ajustar conteo físico"
                            >
                              Conteo / Ajuste
                            </button>
                          </td>
                        </tr>
                      );
                    })
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* --- MODAL 1: ORDER PICKING / PREPARATION CHECKLIST --- */}
      {preparingRemito && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-3xl p-6 relative flex flex-col space-y-4 max-h-[90vh]">
            <div className="flex items-center justify-between border-b border-slate-200 pb-3">
              <div>
                <span className="text-[10px] font-black uppercase text-amber-800 bg-amber-100 px-2 py-0.5 rounded">
                  ARMADO Y PICKING DE DEPOSITO
                </span>
                <h3 className="text-lg font-extrabold text-slate-900 mt-1">
                  Preparando Remito {preparingRemito.numero}
                </h3>
              </div>
              <button
                onClick={() => setPreparingRemito(null)}
                className="p-1.5 text-slate-400 hover:text-slate-800 rounded-lg hover:bg-slate-100 cursor-pointer"
              >
                ✕
              </button>
            </div>

            {/* Customer & Address Details */}
            <div className="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-xs space-y-1">
              <p><strong>Cliente:</strong> {getClienteName(preparingRemito.clienteId)}</p>
              <p><strong>Dirección de Entrega:</strong> {getClienteInfo(preparingRemito.clienteId)?.direccion || 'Sin dirección'}, {getClienteInfo(preparingRemito.clienteId)?.ciudad || 'S/D'}</p>
              {preparingRemito.observaciones && (
                <p className="italic text-slate-600 pt-1 border-t border-slate-200">
                  Obs: {preparingRemito.observaciones}
                </p>
              )}
            </div>

            {/* Progress bar */}
            {(() => {
              const totalItems = preparingRemito.items.length;
              const prepCount = preparingRemito.items.filter(i => i.preparado).length;
              const pct = totalItems > 0 ? Math.round((prepCount / totalItems) * 100) : 0;

              return (
                <div className="space-y-1">
                  <div className="flex items-center justify-between text-xs font-bold text-slate-700">
                    <span>Avance del armado: {prepCount} de {totalItems} ítems listos</span>
                    <span>{pct}%</span>
                  </div>
                  <div className="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
                    <div
                      className="h-full bg-amber-500 transition-all duration-300"
                      style={{ width: `${pct}%` }}
                    />
                  </div>
                </div>
              );
            })()}

            {/* Picking Checklist Table */}
            <div className="overflow-y-auto max-h-[50vh] border border-slate-200 rounded-xl">
              <table className="w-full text-xs text-left">
                <thead>
                  <tr className="bg-slate-100 font-bold text-slate-700 border-b border-slate-200">
                    <th className="p-3 w-12 text-center">Listo</th>
                    <th className="p-3">Código / SKU</th>
                    <th className="p-3">Producto</th>
                    <th className="p-3 text-center">Cant. Requerida</th>
                    <th className="p-3 text-right">Stock en Depósito</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {preparingRemito.items.map((item, idx) => {
                    const prod = getProducto(item.productoId);
                    const isEnoughStock = prod ? prod.stock >= item.cantidad : true;

                    return (
                      <tr
                        key={idx}
                        onClick={() => toggleItemPreparado(preparingRemito.id, item.productoId)}
                        className={`cursor-pointer transition-colors ${
                          item.preparado ? 'bg-emerald-50/80 hover:bg-emerald-100/80' : 'hover:bg-slate-50'
                        }`}
                      >
                        <td className="p-3 text-center">
                          {item.preparado ? (
                            <CheckSquare className="w-5 h-5 text-emerald-600 inline-block" />
                          ) : (
                            <Square className="w-5 h-5 text-slate-300 inline-block" />
                          )}
                        </td>
                        <td className="p-3 font-mono font-bold text-slate-900">
                          {prod?.codigoInterno || prod?.codigo || 'S/C'}
                        </td>
                        <td className="p-3">
                          <div className="font-bold text-slate-900">{prod?.nombre || 'Producto'}</div>
                          {prod?.descripcion && <div className="text-[10px] text-slate-500">{prod.descripcion}</div>}
                        </td>
                        <td className="p-3 text-center font-mono font-black text-sm text-slate-900">
                          {item.cantidad} u.
                        </td>
                        <td className="p-3 text-right font-mono">
                          <span className={`px-2 py-0.5 rounded font-bold ${
                            isEnoughStock ? 'bg-slate-100 text-slate-800' : 'bg-rose-100 text-rose-900'
                          }`}>
                            {prod ? `${prod.stock} u.` : 'S/D'}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {/* Quick Actions & Status Change */}
            <div className="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-slate-200">
              <button
                type="button"
                onClick={() => markAllItemsPreparado(preparingRemito.id)}
                className="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 w-full sm:w-auto justify-center"
              >
                <Check className="w-4 h-4 text-emerald-600" />
                <span>Marcar Todos Listos</span>
              </button>

              <div className="flex items-center gap-2 w-full sm:w-auto justify-end">
                <button
                  onClick={() => {
                    updateRemitoEstado(preparingRemito.id, 'En Preparación');
                  }}
                  className="px-3.5 py-2 bg-amber-100 text-amber-900 hover:bg-amber-200 font-bold text-xs rounded-xl transition-colors cursor-pointer"
                >
                  Guardar en Preparación
                </button>

                <button
                  onClick={() => {
                    updateRemitoEstado(preparingRemito.id, 'Listo para Entrega');
                  }}
                  className="px-3.5 py-2 bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs rounded-xl transition-colors cursor-pointer shadow-xs flex items-center gap-1.5"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>Listo para Entrega</span>
                </button>

                <button
                  onClick={() => {
                    onPrintRemito(preparingRemito);
                  }}
                  className="p-2 bg-slate-900 text-white hover:bg-slate-800 rounded-xl transition-colors cursor-pointer"
                  title="Imprimir remito"
                >
                  <Printer className="w-4 h-4" />
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* --- MODAL 2: NUEVO INGRESO DE STOCK EN DEPÓSITO --- */}
      {isIngresoModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl p-6 relative space-y-4 my-auto">
            <div className="flex items-center justify-between border-b border-slate-200 pb-3">
              <div>
                <span className="text-[10px] font-black uppercase text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                  RECEPCIÓN DE MERCADERÍA
                </span>
                <h3 className="text-lg font-extrabold text-slate-900 mt-1">
                  Registrar Ingreso de Stock a Depósito
                </h3>
              </div>
              <button
                onClick={() => setIsIngresoModalOpen(false)}
                className="p-1.5 text-slate-400 hover:text-slate-800 rounded-lg hover:bg-slate-100 cursor-pointer"
              >
                ✕
              </button>
            </div>

            <form onSubmit={handleSubmitIngreso} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">Fecha de Recepción</label>
                  <input
                    type="date"
                    required
                    value={ingresoFecha}
                    onChange={e => setIngresoFecha(e.target.value)}
                    className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-mono text-xs"
                  />
                </div>

                <div>
                  <label className="block font-bold text-slate-700 mb-1">Proveedor remitente</label>
                  <select
                    required
                    value={ingresoProveedorId}
                    onChange={e => setIngresoProveedorId(e.target.value)}
                    className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs"
                  >
                    <option value="">-- Seleccionar Proveedor --</option>
                    {proveedores.map(p => (
                      <option key={p.id} value={p.id}>{p.nombre}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">Comprobante de Referencia / Remito Prov.</label>
                <input
                  type="text"
                  placeholder="Ej: Remito Proveedor #4512 o Factura B-0001-88"
                  value={ingresoComprobante}
                  onChange={e => setIngresoComprobante(e.target.value)}
                  className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs"
                />
              </div>

              {/* Items Section (NO COSTS) */}
              <div className="space-y-2 pt-2 border-t border-slate-200">
                <div className="flex items-center justify-between">
                  <label className="font-extrabold text-slate-900 text-xs">
                    Productos recibidos en depósito
                  </label>
                  <button
                    type="button"
                    onClick={handleAddIngresoItem}
                    className="px-2.5 py-1 bg-emerald-100 text-emerald-900 font-bold rounded-lg text-xs hover:bg-emerald-200 cursor-pointer flex items-center gap-1"
                  >
                    <Plus className="w-3.5 h-3.5" /> Agregar Ítem
                  </button>
                </div>

                <div className="space-y-2 max-h-[35vh] overflow-y-auto pr-1">
                  {ingresoItems.map((item, idx) => (
                    <div key={idx} className="flex items-center gap-2 p-2 bg-slate-50 rounded-xl border border-slate-200">
                      <select
                        required
                        value={item.productoId}
                        onChange={e => handleIngresoItemChange(idx, 'productoId', e.target.value)}
                        className="flex-1 px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs"
                      >
                        <option value="">-- Seleccionar Producto --</option>
                        {productos.map(p => (
                          <option key={p.id} value={p.id}>
                            [{p.codigoInterno || p.codigo}] {p.nombre} (Stock actual: {p.stock} u.)
                          </option>
                        ))}
                      </select>

                      <div className="w-28 shrink-0">
                        <input
                          type="number"
                          min="1"
                          required
                          placeholder="Cantidad"
                          value={item.cantidad}
                          onChange={e => handleIngresoItemChange(idx, 'cantidad', Number(e.target.value))}
                          className="w-full px-2.5 py-2 bg-white border border-slate-200 rounded-lg text-xs font-mono text-center font-bold"
                        />
                      </div>

                      {ingresoItems.length > 1 && (
                        <button
                          type="button"
                          onClick={() => handleRemoveIngresoItem(idx)}
                          className="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-100 rounded-lg cursor-pointer"
                        >
                          ✕
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">Observaciones / Notas de Entrega</label>
                <textarea
                  rows={2}
                  placeholder="Detalles sobre empaque, estado de la mercadería, transportista..."
                  value={ingresoObservaciones}
                  onChange={e => setIngresoObservaciones(e.target.value)}
                  className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs"
                />
              </div>

              <div className="flex items-center justify-end gap-2 pt-3 border-t border-slate-200">
                <button
                  type="button"
                  onClick={() => setIsIngresoModalOpen(false)}
                  className="px-4 py-2 bg-slate-100 text-slate-700 hover:bg-slate-200 font-bold rounded-xl cursor-pointer"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl cursor-pointer shadow-xs"
                >
                  Confirmar Ingreso a Stock
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* --- MODAL 3: CONTEO / AJUSTE DE STOCK FÍSICO --- */}
      {adjustingProduct && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 relative space-y-4 my-auto text-xs">
            <div className="flex items-center justify-between border-b border-slate-200 pb-3">
              <div>
                <span className="text-[10px] font-black uppercase text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                  CONTEO DE INVENTARIO
                </span>
                <h3 className="text-base font-extrabold text-slate-900 mt-1">
                  Ajustar Stock Físico
                </h3>
              </div>
              <button
                onClick={() => setAdjustingProduct(null)}
                className="p-1 text-slate-400 hover:text-slate-800 rounded-lg cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div className="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
              <p className="font-mono text-slate-500 font-bold">SKU: {adjustingProduct.codigoInterno || adjustingProduct.codigo}</p>
              <p className="font-extrabold text-slate-900 text-sm">{adjustingProduct.nombre}</p>
              <p className="text-slate-500">Stock actual registrado: <strong className="text-slate-900 font-mono">{adjustingProduct.stock} u.</strong></p>
            </div>

            <div>
              <label className="block font-bold text-slate-700 mb-1">
                Nuevo Stock Físico Verificado (Unidades)
              </label>
              <input
                type="number"
                min="0"
                value={adjustNewStock}
                onChange={e => setAdjustNewStock(Number(e.target.value))}
                className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-base font-mono font-bold text-slate-900 text-center"
              />
            </div>

            <div>
              <label className="block font-bold text-slate-700 mb-1">Motivo / Justificación</label>
              <input
                type="text"
                value={adjustReason}
                onChange={e => setAdjustReason(e.target.value)}
                className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl"
              />
            </div>

            <div className="flex items-center justify-end gap-2 pt-3 border-t border-slate-200">
              <button
                type="button"
                onClick={() => setAdjustingProduct(null)}
                className="px-4 py-2 bg-slate-100 text-slate-700 hover:bg-slate-200 font-bold rounded-xl cursor-pointer"
              >
                Cancelar
              </button>
              <button
                type="button"
                onClick={handleConfirmStockAdjustment}
                className="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl cursor-pointer shadow-xs"
              >
                Guardar Nuevo Conteo
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
